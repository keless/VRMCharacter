{
  "name": "vrm-character-app",
  "version": "0.1.0",
  "private": true,
  "description": "Electron app displaying a VRM/VRoid character with chat and customization",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && electron-builder",
    "preview": "vite preview"
  },
  "dependencies": {
    "@pixiv/three-vrm": "^3.3.3",
    "@react-three/drei": "^10.0.4",
    "@react-three/fiber": "^9.0.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.174.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.174.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.7.0",
    "vite": "^6.2.0",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "build": {
    "appId": "com.vrmcharacter.app",
    "productName": "VRM Character",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage",
      "category": "Utility"
    }
  },
  "allowScripts": {
    "electron@43.0.0": true,
    "esbuild@0.25.12": true,
    "@electron/get@^2.0.0": true,
    "@electron-builder@^26.0.0": true
  }
}
